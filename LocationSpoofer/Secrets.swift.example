// ─────────────────────────────────────────────────────────────
// Secrets.swift.example
//
// Copy this file to Secrets.swift, then fill in your token.
//
//   cp LocationSpoofer/Secrets.swift.example LocationSpoofer/Secrets.swift
//
// Secrets.swift is listed in .gitignore and will never be committed.
//
// To enable device log uploads from your phone back to your GitHub
// repo (used by the "Send Logs to GitHub" button and auto-upload):
//   1. Generate a GitHub Personal Access Token with `repo` scope at
//      https://github.com/settings/tokens
//   2. Paste it as the value of `token` below in Secrets.swift.
//
// The app builds and runs without a token — log upload will simply
// report "Token not configured" and be skipped.
// ─────────────────────────────────────────────────────────────

enum GitHubSecrets {
    /// GitHub Personal Access Token with repo write permission.
    static let token = "YOUR_GITHUB_TOKEN_HERE"
}
