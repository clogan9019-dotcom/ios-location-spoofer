// Copy this file to Secrets.swift, fill in your token, then build.
// Secrets.swift is listed in .gitignore and will never be committed.
// ─────────────────────────────────────────────────────────────

enum GitHubSecrets {
    /// A GitHub Personal Access Token with repo write permission.
    /// Generate one at: https://github.com/settings/tokens
    static let token = "YOUR_GITHUB_TOKEN_HERE"
}
